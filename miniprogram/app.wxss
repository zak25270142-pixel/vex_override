/* 全局样式：深色主题（与 frontend 桌面端一致的调试工具观感，OLED 屏省电） */
page {
  background: #12141a;
  color: #e8eaf0;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue",
    "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

/* 通用卡片行 */
.row-card {
  background: #1b1e26;
  border-radius: 16rpx;
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
}

/* 档位徽标：未订 / 低速 / 高速（配色与 frontend 一致） */
.badge {
  display: inline-block;
  min-width: 64rpx;
  text-align: center;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}
.badge-off { background: #2a2e39; color: #8a8f9c; }
.badge-slow { background: #4a3b1a; color: #f0c35a; }
.badge-fast { background: #123a44; color: #4fc3f7; }

/* 主按钮 / 次按钮 */
.btn {
  display: inline-block;
  text-align: center;
  border-radius: 12rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  margin: 0 12rpx;
}
.btn-primary { background: #2b6cb0; color: #fff; }
.btn-danger { background: #c53030; color: #fff; }
.btn-plain { background: #2a2e39; color: #c8cdd6; }
.btn[disabled] { opacity: 0.45; }

/* 连接状态点 */
.dot {
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  vertical-align: middle;
}
.dot-idle { background: #8a8f9c; }
.dot-connecting { background: #f0c35a; }
.dot-connected { background: #48bb78; }
.dot-error { background: #c53030; }
