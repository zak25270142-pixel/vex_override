<!-- 设置页：后端地址、连接/断开、后端连通性测试、链路诊断 -->
<view class="page">

  <!-- 连接状态 -->
  <view class="card conn-card">
    <view class="conn-line">
      <view class="dot dot-{{conn.dot}}"></view>
      <text class="conn-label">{{conn.label}}</text>
    </view>
    <view class="conn-msg">{{conn.msg}}</view>
  </view>

  <!-- 后端地址 -->
  <view class="card">
    <view class="card-title">后端地址（PC 局域网 IP）</view>
    <view class="form-row">
      <text class="form-label">IP</text>
      <input class="form-input" type="text" value="{{host}}" bindinput="onHostInput"
             placeholder="192.168.137.1" />
    </view>
    <view class="form-row">
      <text class="form-label">端口</text>
      <input class="form-input" type="number" value="{{port}}" bindinput="onPortInput"
             placeholder="8000" />
    </view>
    <view class="form-row">
      <text class="form-label">自动连接</text>
      <switch checked="{{autoConnect}}" bindchange="onAutoSwitch" color="#2b6cb0" />
    </view>
    <view class="btn-row">
      <view class="btn btn-primary" bindtap="onSaveConnect">保存并连接</view>
      <view class="btn btn-plain" bindtap="onDisconnect">断开</view>
      <view class="btn btn-plain" bindtap="onTestBackend">测试后端</view>
    </view>
  </view>

  <!-- 测试结果 -->
  <view class="card" wx:if="{{testMsg}}">
    <view class="card-title">后端探测</view>
    <view class="test-msg">{{testMsg}}</view>
  </view>

  <!-- 链路诊断 -->
  <view class="card">
    <view class="card-title">链路诊断（自连接起累计）</view>
    <view class="stats-grid">
      <view class="stat"><text class="stat-num">{{stats.frames}}</text><text class="stat-label">成帧</text></view>
      <view class="stat"><text class="stat-num">{{stats.bytes}}</text><text class="stat-label">字节</text></view>
      <view class="stat"><text class="stat-num err">{{stats.badChecksum}}</text><text class="stat-label">校验失败</text></view>
      <view class="stat"><text class="stat-num err">{{stats.unknownCmd}}</text><text class="stat-label">未知命令字</text></view>
      <view class="stat"><text class="stat-num err">{{stats.overflow}}</text><text class="stat-label">溢出</text></view>
    </view>
  </view>

  <!-- 连接不上时的排查 -->
  <view class="card">
    <view class="card-title">连不上时按序排查</view>
    <view class="help-item">1. 手机与 PC 在同一网段（同连一个热点，或 PC 连手机的热点）</view>
    <view class="help-item">2. PC 上 uvicorn 必须以 0.0.0.0 启动（127.0.0.1 手机连不到）</view>
    <view class="help-item">3. 主控跑的是带二进制协议的固件，且用户程序在运行（非下载界面）</view>
    <view class="help-item">4. "测试后端"通但无数据：点数据页等目录到达；个别量无数据查订阅档位</view>
    <view class="help-item">5. 帧大量损坏：确认没有别的程序同时占串口</view>
  </view>

  <view class="bottom-gap"></view>
</view>
