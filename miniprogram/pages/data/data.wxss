/* 数据表页样式：手机优先，单列大数字，一眼可读 */
.page {
  padding-bottom: 40rpx;
}

/* ---- 顶栏：连接状态 + 停车 ---- */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx 8rpx;
}
.conn {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.conn-label {
  font-size: 26rpx;
  color: #c8cdd6;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.conn-msg {
  font-size: 22rpx;
  color: #6b7280;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.stop-btn {
  flex-shrink: 0;
  font-weight: 600;
  letter-spacing: 4rpx;
  padding: 12rpx 36rpx;
}
.btn-dim {
  opacity: 0.4;
}

/* ---- toast ---- */
.toasts {
  padding: 8rpx 24rpx 0;
}
.toast {
  font-size: 24rpx;
  padding: 12rpx 20rpx;
  border-radius: 10rpx;
  margin-bottom: 8rpx;
}
.toast-warn { background: #4a3b1a; color: #f0c35a; }
.toast-error { background: #4a1f1f; color: #f18a8a; }

/* ---- 分段 + 搜索 ---- */
.toolbar {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx 4rpx;
}
.seg {
  display: flex;
  background: #2a2e39;
  border-radius: 12rpx;
  padding: 4rpx;
  flex-shrink: 0;
}
.seg-item {
  font-size: 26rpx;
  padding: 10rpx 28rpx;
  border-radius: 10rpx;
  color: #8a8f9c;
}
.seg-on {
  background: #1b1e26;
  color: #4fc3f7;
  font-weight: 600;
}
.search {
  flex: 1;
  margin-left: 16rpx;
  background: #2a2e39;
  border-radius: 12rpx;
  font-size: 26rpx;
  padding: 10rpx 20rpx;
  color: #e8eaf0;
}

/* ---- 数据行 ---- */
.mon-row, .tun-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.mon-main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}
.mon-name {
  font-size: 28rpx;
  color: #e8eaf0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.type-tag {
  font-size: 20rpx;
  color: #8a8f9c;
  background: #2a2e39;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}
.mon-val {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
  margin-left: 20rpx;
}
.num {
  font-size: 40rpx;
  font-weight: 600;
  color: #4fc3f7;
  font-variant-numeric: tabular-nums;
}
.num-sm { font-size: 32rpx; }
.unit {
  font-size: 22rpx;
  color: #8a8f9c;
  margin-left: 6rpx;
}
/* 数据陈旧（>1.5s 没刷新）：转灰提示可能断流 */
.stale .num { color: #8a8f9c; font-weight: 400; }

.empty {
  text-align: center;
  color: #6b7280;
  font-size: 26rpx;
  padding: 80rpx 0;
}

.bottom-gap { height: 40rpx; }

/* ---- 调参编辑弹层 ---- */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.dialog {
  width: 600rpx;
  background: #1b1e26;
  border-radius: 20rpx;
  padding: 32rpx;
}
.dlg-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #e8eaf0;
  margin-bottom: 8rpx;
}
.dlg-sub {
  font-size: 22rpx;
  color: #8a8f9c;
  margin-bottom: 24rpx;
}
.dlg-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}
.dlg-label { font-size: 28rpx; color: #c8cdd6; }
.dlg-input {
  background: #2a2e39;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 16rpx 20rpx;
  color: #e8eaf0;
  margin-bottom: 8rpx;
}
.dlg-hint {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}
.dlg-btns {
  display: flex;
  justify-content: flex-end;
  margin-top: 24rpx;
}
